{
  "rewrites": [
    {"source": "/indir", "destination": "/indir.html"},
    {"source": "/surumler", "destination": "/surumler.html"},
    {"source": "/kosullar", "destination": "/kosullar.html"},
    {"source": "/iletisim", "destination": "/iletisim.html"},
    {"source": "/sss", "destination": "/sss.html"}
  ],
  "headers": [
    {"source": "/(.*)\\.(html|js|css|py)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/demo/program.zip", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/demo/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}, {"key": "Service-Worker-Allowed", "value": "/demo/"}]},
    {"source": "/indir/(.*)\\.zip", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ]
}
